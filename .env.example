# Base URL of the PHP API. Leave empty in dev to use the Vite proxy on :5173.
VITE_API_BASE=
# Where the Vite dev proxy forwards /api (must match `php -S` in backend/public)
VITE_API_PROXY=http://localhost:8080

# Supabase browser keys. The anon key is public by design; row level security
# in backend/supabase/migrations is what protects the data, not secrecy here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
